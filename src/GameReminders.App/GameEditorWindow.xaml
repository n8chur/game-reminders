<Window x:Class="GameReminders.App.GameEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game setup" Height="720" Width="760" MinHeight="620" MinWidth="680"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="SourceTypeText" FontWeight="SemiBold" />
                    <TextBlock x:Name="SourceHelpText" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="1" Text="Name" FontWeight="SemiBold" />
            <TextBox x:Name="NameText" Grid.Row="2" Margin="0,5,0,14" Padding="7" />
            <TextBlock Grid.Row="3" Text="Speech aliases (optional; one per line)" FontWeight="SemiBold" />
            <TextBox x:Name="AliasesText" Grid.Row="4" Margin="0,5,0,14" Padding="7" Height="64" AcceptsReturn="True" />

            <TextBlock x:Name="ProcessesLabel" Grid.Row="5" Text="Executable paths or names (one per line)" FontWeight="SemiBold" />
            <TextBlock x:Name="ProcessesHelp" Grid.Row="6" Margin="0,3,0,5" Height="34"
                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="Add every executable that should count as launching this game." />
            <Grid Grid.Row="7" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="ProcessesText" Padding="7" Height="82" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" TextChanged="ProcessesText_Changed" />
                <Button x:Name="BrowseExecutableButton" Grid.Column="1" Content="Browse…" Margin="8,0,0,0"
                        VerticalAlignment="Top" Click="BrowseExecutable_Click" />
            </Grid>

            <TextBlock x:Name="CandidatesLabel" Grid.Row="8"
                       Text="Detected paths (select to replace; + adds another)" FontWeight="SemiBold" />
            <ListBox x:Name="CandidatesList" Grid.Row="9" Margin="0,5,0,5" Padding="4" Height="156"
                     SelectionMode="Single" SelectionChanged="CandidateSelected"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="8,4" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Tag="{Binding}" Margin="8,0,0,0"
                                    Width="28" MinWidth="28" Height="28" MinHeight="28" Padding="0"
                                    Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    ToolTip="Add this path" Click="AddCandidate_Click"
                                    AutomationProperties.Name="Add this path">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="14">
                                            <Path Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M 5,0 L 5,10 M 0,5 L 10,5"
                                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock Text="{Binding}" ToolTip="{Binding}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="CandidatesHelp" Grid.Row="10" Margin="0,0,0,14" Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap" Text="Detected paths remain available after saving so the mapping can be corrected later." />

            <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" />
                <Button x:Name="SaveButton" Content="Save" Click="Save_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
