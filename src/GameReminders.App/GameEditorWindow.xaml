<Window x:Class="GameReminders.App.GameEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game setup" Height="520" Width="680" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Name" FontWeight="SemiBold" />
        <TextBox x:Name="NameText" Grid.Row="1" Margin="0,5,0,14" Padding="7" />
        <TextBlock Grid.Row="2" Text="Speech aliases (one per line)" FontWeight="SemiBold" />
        <TextBox x:Name="AliasesText" Grid.Row="3" Margin="0,5,0,14" Padding="7" Height="70" AcceptsReturn="True" />
        <TextBlock Grid.Row="4" Text="Executable paths or names (one per line)" FontWeight="SemiBold" />
        <TextBox x:Name="ProcessesText" Grid.Row="5" Margin="0,5,0,14" Padding="7" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
        <TextBlock x:Name="CandidatesLabel" Grid.Row="6" Text="Detected paths (click one to use it)" FontWeight="SemiBold" />
        <ListBox x:Name="CandidatesList" Grid.Row="7" Margin="0,5,0,14" Padding="4" Height="76"
                 SelectionChanged="CandidateSelected" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Save" Click="Save_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
