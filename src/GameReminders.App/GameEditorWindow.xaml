<Window x:Class="GameReminders.App.GameEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game setup" Height="680" Width="760" MinHeight="620" MinWidth="680"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#E8EEF7" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="SourceTypeText" FontWeight="SemiBold" />
                    <TextBlock x:Name="SourceHelpText" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="#555" />
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="1" Text="Name" FontWeight="SemiBold" />
            <TextBox x:Name="NameText" Grid.Row="2" Margin="0,5,0,14" Padding="7" />
            <TextBlock Grid.Row="3" Text="Speech aliases (optional; one per line)" FontWeight="SemiBold" />
            <TextBox x:Name="AliasesText" Grid.Row="4" Margin="0,5,0,14" Padding="7" Height="64" AcceptsReturn="True" />

            <TextBlock Grid.Row="5" Text="Executable paths or names (one per line)" FontWeight="SemiBold" />
            <TextBlock Grid.Row="6" Margin="0,3,0,5" TextWrapping="Wrap" Foreground="#555"
                       Text="Add every executable that should count as launching this game." />
            <Grid Grid.Row="7" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="ProcessesText" Padding="7" Height="82" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" TextChanged="ProcessesText_Changed" />
                <Button x:Name="BrowseExecutableButton" Grid.Column="1" Content="Browse…" Margin="8,0,0,0"
                        VerticalAlignment="Top" Click="BrowseExecutable_Click" />
            </Grid>

            <Border x:Name="ActionRequiredPanel" Grid.Row="8" Background="#FFF3CD" BorderBrush="#D97706"
                    BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="ACTION REQUIRED" FontWeight="Bold" Foreground="#9A4D00" />
                    <TextBlock Margin="0,3,0,0" TextWrapping="Wrap"
                               Text="Choose at least one executable path below, or enter one in the Executable paths field. Save is disabled until this is resolved." />
                </StackPanel>
            </Border>

            <TextBlock x:Name="CandidatesLabel" Grid.Row="9"
                       Text="Detected paths (click to add; Ctrl/Shift selects several)" FontWeight="SemiBold" />
            <ListBox x:Name="CandidatesList" Grid.Row="10" Margin="0,5,0,5" Padding="4" Height="116"
                     SelectionMode="Extended" SelectionChanged="CandidateSelected"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Add" Tag="{Binding}" Margin="8,0,0,0"
                                    Click="AddCandidate_Click" />
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="CandidatesHelp" Grid.Row="11" Margin="0,0,0,14" Foreground="#555"
                       TextWrapping="Wrap" Text="Detected paths remain available after saving so the mapping can be corrected later." />

            <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" />
                <Button x:Name="SaveButton" Content="Save" Click="Save_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
