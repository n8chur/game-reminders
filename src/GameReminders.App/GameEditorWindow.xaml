<Window x:Class="GameReminders.App.GameEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game setup" Height="390" Width="590" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Name" FontWeight="SemiBold" />
        <TextBox x:Name="NameText" Grid.Row="1" Margin="0,5,0,14" Padding="7" />
        <TextBlock Grid.Row="2" Text="Speech aliases (one per line)" FontWeight="SemiBold" />
        <TextBox x:Name="AliasesText" Grid.Row="3" Margin="0,5,0,14" Padding="7" Height="70" AcceptsReturn="True" />
        <TextBlock Grid.Row="4" Text="Executable names (one per line)" FontWeight="SemiBold" />
        <TextBox x:Name="ProcessesText" Grid.Row="5" Margin="0,5,0,14" Padding="7" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Save" Click="Save_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
