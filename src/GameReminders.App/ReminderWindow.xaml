<Window x:Class="GameReminders.App.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game reminder"
        SizeToContent="WidthAndHeight"
        MinWidth="520" MaxWidth="760" MaxHeight="700"
        WindowStartupLocation="CenterScreen"
        Topmost="True" ShowActivated="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" Grid.Row="0"
                   FontSize="23" FontWeight="SemiBold" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ReminderList" />
        </ScrollViewer>

        <TextBlock Grid.Row="2" Margin="0,12,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                   Text="Closing this window keeps every unresolved reminder pending for the next launch." />
    </Grid>
</Window>
