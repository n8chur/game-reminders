<Window x:Class="GameReminders.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Reminders — Milestone 1"
        Height="320" Width="620"
        MinHeight="280" MinWidth="520"
        Background="{StaticResource WindowBackground}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Game Reminders is running"
                   FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

        <Border Grid.Row="1" Padding="14" Background="White" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="iCloud folder" FontWeight="SemiBold" />
                <TextBlock x:Name="RootPathText" Margin="0,4,0,12" TextWrapping="Wrap" />
                <TextBlock Text="Status" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Margin="0,16,0,12" TextWrapping="Wrap"
                   Text="For this prototype, configure executable names directly in games.json. After saving it, choose Reload games.json below." />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Open folder" Click="OpenFolder_Click" />
            <Button Content="Reload games.json" Click="Reload_Click" />
            <Button Content="Exit" Click="Exit_Click" />
        </StackPanel>
    </Grid>
</Window>

