<Window x:Class="GameReminders.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Reminders" Height="560" Width="760"
        MinHeight="480" MinWidth="680" Background="{StaticResource WindowBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
            <TextBlock Text="Game Reminders" FontSize="24" FontWeight="SemiBold" DockPanel.Dock="Left" />
            <TextBlock Text="Running in the notification area" VerticalAlignment="Center"
                       Foreground="#666" DockPanel.Dock="Right" />
        </DockPanel>

        <Border Grid.Row="1" Padding="12" Background="White" CornerRadius="8" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="iCloud folder" FontWeight="SemiBold" />
                <TextBlock x:Name="RootPathText" Margin="0,3,0,8" TextWrapping="Wrap" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TabControl x:Name="ManagementTabs" Grid.Row="2">
            <TabItem x:Name="GamesTab" Header="Games">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ListBox x:Name="GamesList" MouseDoubleClick="EditGame_Click"
                             SelectionChanged="GamesList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right" Background="#D97706" CornerRadius="7" Padding="6,1"
                                            Visibility="{Binding BadgeVisibility}" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="{Binding Game.Name}" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Add game" Click="AddGame_Click" />
                        <Button Content="Edit" Click="EditGame_Click" />
                        <Button Content="Remove" Click="RemoveGame_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="DetectedGamesTab" Header="Detected games">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ListBox x:Name="PendingList" DisplayMemberPath="Name" MouseDoubleClick="ConfigureDetection_Click" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Configure" Click="ConfigureDetection_Click" />
                        <Button Content="Ignore" Click="IgnoreDetection_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="RemovedSteamGamesTab" Header="Removed Steam games">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ListBox x:Name="SuppressedSteamList" DisplayMemberPath="Name" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Allow re-add" Click="RestoreSteamGame_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Open folder" Click="OpenFolder_Click" ToolTip="Open the authoritative iCloud Game Reminders folder" />
            <Button Content="Reload games.json" Click="Reload_Click" ToolTip="Reload the existing game catalog from iCloud" />
            <Button Content="Scan Steam" Click="ScanSteam_Click" ToolTip="Discover installed Steam games and update the catalog" />
            <Button Content="Hide" Click="Hide_Click" />
            <Button Content="Exit" Click="Exit_Click" />
        </StackPanel>
    </Grid>
</Window>
