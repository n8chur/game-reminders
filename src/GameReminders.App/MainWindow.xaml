<Window x:Class="GameReminders.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Reminders" Height="680" Width="820"
        MinHeight="560" MinWidth="700" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Scan Steam" Click="ScanSteam_Click"
                            Height="34" MinHeight="34"
                            ToolTip="Discover installed Steam games" />
                    <Button Content="New reminder" Click="NewReminder_Click"
                            Height="34" MinHeight="34" IsDefault="True" />
                </StackPanel>
                <CheckBox x:Name="LaunchAtLoginCheckBox"
                          Content="Launch at login" Margin="0,9,0,0"
                          HorizontalAlignment="Right" Click="LaunchAtLogin_Click" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Game Reminders" FontSize="27" FontWeight="SemiBold" />
                <TextBlock Text="Remember what matters the next time you play"
                           Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
        </DockPanel>

        <Border x:Name="StatusBanner" Grid.Row="1" CornerRadius="7" Padding="12,9" Margin="0,0,0,14"
                Background="{DynamicResource NoticeBackgroundBrush}" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="×" Click="DismissStatus_Click"
                        ToolTip="Dismiss message" MinWidth="28" Width="28" Height="28" MinHeight="28"
                        Padding="0" Margin="10,0,0,0" FontSize="16" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource NoticeTextBrush}" />
            </DockPanel>
        </Border>

        <TabControl x:Name="ManagementTabs" Grid.Row="2">
            <TabItem x:Name="RemindersTab" Header="Reminders">
                <Grid Margin="16">
                    <TabControl x:Name="ReminderCategories">
                        <TabItem x:Name="PendingRemindersTab" Header="Pending (0)">
                            <Grid Margin="12">
                                <ListBox x:Name="PendingRemindersList">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel LastChildFill="True">
                                                <Button DockPanel.Dock="Right" Content="Complete" Tag="{Binding Reminder}"
                                                        Click="CompleteReminder_Click" Margin="14,0,0,0"
                                                        VerticalAlignment="Center" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Reminder.Message}" FontSize="15"
                                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Details}" Margin="0,4,0,0" FontSize="12"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="PendingRemindersEmpty" Text="No pending reminders. Create one for your next game session."
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="NextLaunchRemindersTab" Header="Next launch (0)">
                            <Grid Margin="12">
                                <ListBox x:Name="NextLaunchRemindersList">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel LastChildFill="True">
                                                <Button DockPanel.Dock="Right" Content="Complete" Tag="{Binding Reminder}"
                                                        Click="CompleteReminder_Click" Margin="14,0,0,0"
                                                        VerticalAlignment="Center" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Reminder.Message}" FontSize="15"
                                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Details}" Margin="0,4,0,0" FontSize="12"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="NextLaunchRemindersEmpty" Text="Nothing is deferred to the next launch."
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="CompletedRemindersTab" Header="Completed (0)">
                            <Grid Margin="12">
                                <ListBox x:Name="CompletedRemindersList">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel LastChildFill="True" Opacity="0.72">
                                                <TextBlock DockPanel.Dock="Left" Text="✓" FontSize="18" Margin="0,0,10,0"
                                                           Foreground="{DynamicResource PrimaryBrush}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Reminder.Message}" FontSize="15"
                                                               TextDecorations="Strikethrough" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Details}" Margin="0,4,0,0" FontSize="12"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="CompletedRemindersEmpty" Text="Completed reminders will appear here."
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
            <TabItem x:Name="GamesTab" Header="Games">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="SearchText" Grid.Row="0" Height="36" Padding="10,7" Margin="0,0,0,14"
                             TextChanged="SearchText_Changed" ToolTip="Filter games and action-required items"
                             AutomationProperties.Name="Search games" />

                    <Border x:Name="DetectedSection" Grid.Row="1" Margin="0,0,0,16" Padding="12"
                            Background="{DynamicResource SurfaceMutedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,3">
                                <TextBlock x:Name="DetectedCountText" DockPanel.Dock="Right"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="Action required" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource IssueTextBrush}" />
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="Configure this detection as a game, or ignore it."
                                       Margin="0,0,0,8" FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <ListBox x:Name="PendingList" Grid.Row="2" MouseDoubleClick="ConfigureDetection_Click"
                                     SelectionChanged="PendingList_SelectionChanged" MaxHeight="170">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="Detected application" FontSize="12" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                                        Margin="0,10,0,0">
                                <Button x:Name="ConfigureDetectionButton" Content="Configure"
                                        Click="ConfigureDetection_Click" IsEnabled="False" />
                                <Button x:Name="IgnoreDetectionButton" Content="Ignore"
                                        Click="IgnoreDetection_Click" IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,7">
                            <TextBlock x:Name="ConfiguredCountText" DockPanel.Dock="Right"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="Games" FontSize="15" FontWeight="SemiBold" />
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <ListBox x:Name="GamesList" MouseDoubleClick="EditGame_Click"
                                     SelectionChanged="GamesList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Right" Background="{Binding BadgeBackground}"
                                                    CornerRadius="10" Height="20" Padding="7,0"
                                                    Visibility="{Binding BadgeVisibility}" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="10"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                                           LineHeight="12" LineStackingStrategy="BlockLineHeight" />
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Game.Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SourceLabel}" FontSize="12" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="GamesEmptyText" Text="No games match this search."
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Visibility="Collapsed" />
                        </Grid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                    Margin="0,14,0,0">
                            <Button Content="Add game" Click="AddGame_Click" />
                            <Button x:Name="EditGameButton" Content="Edit" Click="EditGame_Click"
                                    IsEnabled="False" />
                            <Button x:Name="RemoveGameButton" Content="Remove" Click="RemoveGame_Click"
                                    IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="IgnoredTab" Header="Ignored">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Ignored discoveries" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <ListBox x:Name="IgnoredList" SelectionChanged="IgnoredList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SourceLabel}" FontSize="12" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="IgnoredEmptyText" Text="No ignored discoveries."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Grid>
                    <Button x:Name="RestoreIgnoredButton" Grid.Row="2" Content="Restore"
                            HorizontalAlignment="Right" Margin="0,14,0,0"
                            Click="RestoreIgnored_Click" IsEnabled="False" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
