<Window x:Class="GameReminders.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Reminders" Height="560" Width="760"
        MinHeight="480" MinWidth="680" Background="{StaticResource WindowBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
            <TextBlock Text="Game Reminders" FontSize="24" FontWeight="SemiBold" DockPanel.Dock="Left" />
            <TextBlock Text="Running in the notification area" VerticalAlignment="Center"
                       Foreground="#666" DockPanel.Dock="Right" />
        </DockPanel>

        <Border Grid.Row="1" Padding="12" Background="White" CornerRadius="8" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="iCloud folder" FontWeight="SemiBold" />
                <TextBlock x:Name="RootPathText" Margin="0,3,0,8" TextWrapping="Wrap" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Games">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ListBox x:Name="GamesList" DisplayMemberPath="Name" MouseDoubleClick="EditGame_Click" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Add game" Click="AddGame_Click" />
                        <Button Content="Edit" Click="EditGame_Click" />
                        <Button Content="Remove" Click="RemoveGame_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Detected games">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ListBox x:Name="PendingList" DisplayMemberPath="Name" MouseDoubleClick="ConfigureDetection_Click" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Scan Steam" Click="ScanSteam_Click" />
                        <Button Content="Configure" Click="ConfigureDetection_Click" />
                        <Button Content="Ignore" Click="IgnoreDetection_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Open folder" Click="OpenFolder_Click" />
            <Button Content="Reload" Click="Reload_Click" />
            <Button Content="Hide" Click="Hide_Click" />
            <Button Content="Exit" Click="Exit_Click" />
        </StackPanel>
    </Grid>
</Window>
