<Window x:Class="GameReminders.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Reminders" Height="680" Width="820"
        MinHeight="560" MinWidth="700" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <Button Content="Scan Steam" DockPanel.Dock="Right" Click="ScanSteam_Click"
                    ToolTip="Discover installed Steam games" />
            <StackPanel>
                <TextBlock Text="Game Reminders" FontSize="27" FontWeight="SemiBold" />
                <TextBlock Text="Choose which games should show your reminders"
                           Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
        </DockPanel>

        <Border x:Name="StatusBanner" Grid.Row="1" CornerRadius="7" Padding="12,9" Margin="0,0,0,14"
                Background="{DynamicResource NoticeBackgroundBrush}" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="×" Click="DismissStatus_Click"
                        ToolTip="Dismiss message" MinWidth="28" Width="28" Height="28" MinHeight="28"
                        Padding="0" Margin="10,0,0,0" FontSize="16" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource NoticeTextBrush}" />
            </DockPanel>
        </Border>

        <TabControl x:Name="ManagementTabs" Grid.Row="2">
            <TabItem x:Name="GamesTab" Header="Games">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="SearchText" Grid.Row="0" Height="36" Padding="10,7" Margin="0,0,0,14"
                             TextChanged="SearchText_Changed" ToolTip="Filter configured and detected games"
                             AutomationProperties.Name="Search games" />

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,7">
                            <TextBlock x:Name="ConfiguredCountText" DockPanel.Dock="Right"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="Configured" FontSize="15" FontWeight="SemiBold" />
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <ListBox x:Name="GamesList" MouseDoubleClick="EditGame_Click"
                                     SelectionChanged="GamesList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Right" Background="{Binding BadgeBackground}"
                                                    CornerRadius="10" Height="20" Padding="7,0"
                                                    Visibility="{Binding BadgeVisibility}" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="10"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                                           LineHeight="12" LineStackingStrategy="BlockLineHeight" />
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Game.Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SourceLabel}" FontSize="12" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="GamesEmptyText" Text="No configured games match this search."
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Visibility="Collapsed" />
                        </Grid>
                    </Grid>

                    <Grid x:Name="DetectedSection" Grid.Row="2" Margin="0,18,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,7">
                            <TextBlock x:Name="DetectedCountText" DockPanel.Dock="Right"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="Needs review" FontSize="15" FontWeight="SemiBold" />
                        </DockPanel>
                        <ListBox x:Name="PendingList" Grid.Row="1" MouseDoubleClick="ConfigureDetection_Click"
                                 MaxHeight="170">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="Detected application" FontSize="12" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <DockPanel Grid.Row="3" Margin="0,14,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Add game" Click="AddGame_Click" />
                            <Button Content="Edit" Click="EditGame_Click" />
                            <Button Content="Remove" Click="RemoveGame_Click" />
                        </StackPanel>
                        <StackPanel x:Name="DetectionActions" Orientation="Horizontal">
                            <Button Content="Configure" Click="ConfigureDetection_Click" />
                            <Button Content="Ignore" Click="IgnoreDetection_Click" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="IgnoredTab" Header="Ignored">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Ignored discoveries" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <ListBox x:Name="IgnoredList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SourceLabel}" FontSize="12" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="IgnoredEmptyText" Text="No ignored discoveries."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Grid>
                    <Button Grid.Row="2" Content="Restore" HorizontalAlignment="Right" Margin="0,14,0,0"
                            Click="RestoreIgnored_Click" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
