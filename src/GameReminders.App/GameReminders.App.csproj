<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\GameReminders.ico</ApplicationIcon>
    <AssemblyName>GameReminders</AssemblyName>
    <RootNamespace>GameReminders.App</RootNamespace>
    <Product>Game Reminders</Product>
    <Company>Game Reminders</Company>
    <Authors>n8chur</Authors>
    <Description>Game launch reminders synchronized through iCloud Drive</Description>
    <RepositoryUrl>https://github.com/n8chur/game-reminders</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameReminders.Core\GameReminders.Core.csproj" />
  </ItemGroup>
</Project>
