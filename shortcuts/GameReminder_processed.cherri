/*
Text Editing Actions
*/

// [Doc]: [Rich Text] Make HTML: Make HTML from Rich Text.


// [Doc]: [Rich Text] Make Rich Text from HTML


// [Doc]: [Rich Text] Make Markdown: Make Markdown from Rich Text.


// [Doc]: [Rich Text] Get Rich Text from Markdown








// [Doc]: Dictation: Transcribes user recorded audio to text, optionally in another language.


// [Doc]: Get Text from Image


// [Doc]: Get Name of Emoji: Detects emoji in the text and returns its name.


// [Doc]: Get Text: Get text from input.


// [Doc]: Make Spoken Audio: Creates custom spoken audio from text with controls for rate and pitch.


// [Doc]: Define: Returns the definition of the word.


// [Doc]: Speak: Speaks the provided text, optionally in another language.


// [Doc]: Transcribe Audio: Transcribes text from the provided audio.


// [Doc]: [Text Editing] Uppercase: Transforms the text to all uppercase.





// [Doc]: [Text Editing] Lowercase: Transforms the text to all lowercase.





// [Doc]: [Text Editing] Capitalize: Capitalizes the text with sentence case.





// [Doc]: [Text Editing] Capitalize All: Capitalizes every word in the text.





// [Doc]: [Text Editing] Title Case: Capitalizes the text with Title Case.





// [Doc]: [Text Editing] Alternating Case: Capitalizes the text with alternating case.





// [Doc]: [Text Editing] Correct Spelling: Corrects the spelling of the provided text.




// [Doc]: [Text Editing] Replace Text: Replace `find` in `subject`, optionally using a regular expression or case insensitive search. Use raw text (single quotes) to match using an regular expression with braces to avoid conflicts with the regular expression syntax.








// [Doc]: [Text Editing] Trim Whitespace: Trim any whitespace from the start and end of `text`.


// [Doc]: [Regular Expressions] Match Text: Use regular expressions to match text. Use raw text (single quotes) to match using an regular expression with braces to avoid conflicts with the regular expression syntax.


// [Doc]: [Regular Expressions] Get Match Group: Get match group at `index` in `matches`.




// [Doc]: [Regular Expressions] Get Match Groups: Get all groups in `matches`.





#question catalogFolder "Choose your Game Reminders folder in iCloud Drive." ""
#question inboxBaseFolder "Choose the same Game Reminders folder again for the inbox." ""









const gamesFile = getConfiguredFile("games.json", catalogFolder, true)
const catalog = getDictionary(gamesFile)
const schemaVersion = getValue(catalog, "schemaVersion")
const schemaVersionNumber = getNumbers(schemaVersion)

if schemaVersionNumber != 1 {
    alert("games.json uses an unsupported format. Update Game Reminders on Windows, then try again.", "Game Reminder")
    stop()
}

const games = getValue(catalog, "games")
const requestedGameName = prompt("Which game?")
const requestedLower = lowercase(requestedGameName)
const requestedGameKey = replaceText('[^\p{L}\p{N}]', "", requestedLower, true, true)

if !requestedGameKey {
    alert("Enter a game name.", "Game Reminder")
    stop()
}

@matchCount = 0
@matchedGameId = "NO_MATCH"
@matchedGameName = "NO_MATCH"

for gameItem in games {
    const game = getDictionary(@gameItem)
    const gameName = getValue(game, "name")
    const aliases = getValue(game, "aliases")
    @gameMatched = false
    const gameNameLower = lowercase("{gameName}")
    const gameNameKey = replaceText('[^\p{L}\p{N}]', "", gameNameLower, true, true)
    if gameNameKey == requestedGameKey {
        @gameMatched = true
    }

    for alias in aliases {
        if @gameMatched == false {
            const aliasLower = lowercase(@alias)
            const aliasKey = replaceText('[^\p{L}\p{N}]', "", aliasLower, true, true)
            if aliasKey == requestedGameKey {
                @gameMatched = true
            }
        }
    }

    if @gameMatched == true {
        @matchCount += 1
        const gameId = getValue(game, "id")
        @matchedGameId = "{gameId}"
        @matchedGameName = "{gameName}"
    }
}

if @matchCount == 0 {
    alert("No game alias found for “{requestedGameName}”.", "Game Reminder")
    stop()
}

if @matchCount > 1 {
    alert("More than one game matched. Make the aliases unique on Windows, then try again.", "Game Reminder")
    stop()
}

const message = prompt("What should I remind you?")
const trimmedMessage = trimWhitespace(message)
if !trimmedMessage {
    alert("Enter a reminder.", "Game Reminder")
    stop()
}

const now = currentDate()
const createdAt = formatDate(now, "ISO 8601")
const random1 = randomNumber(0, 2147483647)
const random2 = randomNumber(0, 2147483647)
const random3 = randomNumber(0, 2147483647)
const random4 = randomNumber(0, 2147483647)
@uuidSeed = "{createdAt}-{random1}-{random2}-{random3}-{random4}"
const uuidHash = hash(@uuidSeed, "SHA256")
const reminderId = replaceText('^(.{8})(.{4})(.{4})(.{4})(.{12}).*$', "$1-$2-$3-$4-$5", uuidHash, true, true)

@reminder = {
    "schemaVersion": 1,
    "id": "{reminderId}",
    "gameId": "{@matchedGameId}",
    "gameNameAtCreation": "{@matchedGameName}",
    "message": "{message}",
    "createdAt": "{createdAt}"
}

const reminderJson = getText(@reminder)
const inboxFolder = getFile("inbox", inboxBaseFolder, true)
const stagedFile = saveFile("{reminderId}.tmp", reminderJson, false)
const inboxStagedFile = moveFile(stagedFile, inboxFolder)
const savedReminder = rename(inboxStagedFile, "{reminderId}.json")
show("Reminder saved for {@matchedGameName}.")
