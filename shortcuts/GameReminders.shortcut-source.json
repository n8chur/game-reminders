{
  "format": "game-reminders-shortcut-source",
  "formatVersion": 1,
  "name": "Game Reminder",
  "platform": "iPhone and iPad Shortcuts",
  "distribution": {
    "unsignedArtifact": "GameReminder-unsigned.shortcut",
    "signedArtifact": "Game Reminder.shortcut",
    "status": "requires-apple-signing",
    "sharingMode": "anyone"
  },
  "configuration": {
    "iCloudContainer": "Shortcuts",
    "relativeFolder": "Game Reminders",
    "importQuestions": false
  },
  "normalization": {
    "case": "lowercase",
    "replacePattern": "[^\\p{L}\\p{N}]",
    "replacement": "",
    "replaceAll": true
  },
  "workflow": [
    {
      "action": "getFile",
      "folder": "Shortcuts",
      "relativePath": "Game Reminders/games.json",
      "error": "Game Reminders could not read iCloud Drive/Shortcuts/Game Reminders/games.json."
    },
    {
      "action": "parseDictionary",
      "input": "games.json",
      "output": "catalog",
      "error": "games.json is not valid JSON. Fix or reload it on Windows, then try again."
    },
    {
      "action": "require",
      "conditions": [
        "catalog.schemaVersion equals number 1",
        "catalog.games is a list"
      ],
      "error": "games.json uses an unsupported format. Update Game Reminders on Windows."
    },
    {
      "action": "askForText",
      "prompt": "Which game?",
      "output": "requestedGameName"
    },
    {
      "action": "normalize",
      "input": "requestedGameName",
      "output": "requestedGameKey"
    },
    {
      "action": "requireNonEmpty",
      "input": "requestedGameKey",
      "error": "Enter a game name."
    },
    {
      "action": "initializeNumber",
      "value": 0,
      "output": "matchCount"
    },
    {
      "action": "initializeText",
      "value": "NO_MATCH",
      "output": "matchedGameId"
    },
    {
      "action": "initializeText",
      "value": "NO_MATCH",
      "output": "matchedGameName"
    },
    {
      "action": "repeatEach",
      "input": "catalog.games",
      "item": "game",
      "steps": [
        {
          "action": "initializeBoolean",
          "value": false,
          "output": "gameMatched"
        },
        {
          "action": "normalize",
          "input": "game.name",
          "output": "gameNameKey"
        },
        {
          "action": "if",
          "condition": "gameNameKey equals requestedGameKey",
          "then": [
            {
              "action": "setVariable",
              "variable": "gameMatched",
              "value": true
            }
          ]
        },
        {
          "action": "repeatEach",
          "input": "game.aliases",
          "item": "alias",
          "steps": [
            {
              "action": "if",
              "condition": "gameMatched equals false",
              "then": [
                {
                  "action": "normalize",
                  "input": "alias",
                  "output": "aliasKey"
                },
                {
                  "action": "if",
                  "condition": "aliasKey equals requestedGameKey",
                  "then": [
                    {
                      "action": "setVariable",
                      "variable": "gameMatched",
                      "value": true
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "action": "if",
          "condition": "gameMatched equals true",
          "then": [
            {
              "action": "incrementVariable",
              "variable": "matchCount",
              "value": 1
            },
            {
              "action": "setVariable",
              "variable": "matchedGameId",
              "value": "game.id"
            },
            {
              "action": "setVariable",
              "variable": "matchedGameName",
              "value": "game.name"
            }
          ]
        }
      ]
    },
    {
      "action": "branchOnCount",
      "input": "matchCount",
      "branches": {
        "zero": {
          "show": "No game alias found for “<requestedGameName>”.",
          "stop": true
        },
        "moreThanOne": {
          "show": "More than one game matched. Make the aliases unique on Windows, then try again.",
          "stop": true
        },
        "one": "continue"
      }
    },
    {
      "action": "askForText",
      "prompt": "What should I remind you?",
      "output": "message"
    },
    {
      "action": "requireNonWhitespace",
      "input": "message",
      "error": "Enter a reminder."
    },
    {
      "action": "generateUuid",
      "output": "reminderId"
    },
    {
      "action": "currentDate",
      "format": "ISO 8601",
      "output": "createdAt"
    },
    {
      "action": "dictionary",
      "output": "reminder",
      "entries": {
        "schemaVersion": 1,
        "id": "reminderId",
        "gameId": "matchedGameId",
        "gameNameAtCreation": "matchedGameName",
        "message": "message",
        "createdAt": "createdAt"
      }
    },
    {
      "action": "serializeJson",
      "input": "reminder",
      "output": "reminderJson"
    },
    {
      "action": "createFolder",
      "folder": "Shortcuts",
      "output": "inboxFolder",
      "path": "Game Reminders/inbox",
      "existingBehavior": "reuse"
    },
    {
      "action": "saveFile",
      "input": "reminderJson",
      "folder": "Shortcuts",
      "name": "<reminderId>.tmp",
      "overwrite": false,
      "output": "stagedFile"
    },
    {
      "action": "moveFile",
      "input": "stagedFile",
      "folder": "inboxFolder",
      "overwrite": false,
      "output": "inboxStagedFile"
    },
    {
      "action": "renameFile",
      "input": "inboxStagedFile",
      "name": "<reminderId>.json",
      "overwrite": false,
      "output": "savedReminder"
    },
    {
      "action": "showResult",
      "message": "Reminder saved for <matchedGameName>.",
      "onlyAfter": "savedReminder"
    }
  ]
}
