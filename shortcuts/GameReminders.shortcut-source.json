{
  "format": "game-reminders-shortcut-source",
  "formatVersion": 1,
  "name": "Game Reminder",
  "platform": "iPhone and iPad Shortcuts",
  "distribution": {
    "unsignedArtifact": "GameReminder-unsigned.shortcut",
    "signedArtifact": "Game Reminder.shortcut",
    "status": "requires-apple-signing",
    "sharingMode": "anyone"
  },
  "configuration": {
    "iCloudContainer": "Shortcuts",
    "relativeFolder": "Game Reminders",
    "importQuestions": false
  },
  "workflow": [
    {
      "action": "getFile",
      "folder": "Shortcuts",
      "relativePath": "Game Reminders/games.json",
      "error": "Game Reminders could not read iCloud Drive/Shortcuts/Game Reminders/games.json."
    },
    {
      "action": "parseDictionary",
      "input": "games.json",
      "output": "catalog",
      "error": "games.json is not valid JSON. Fix or reload it on Windows, then try again."
    },
    {
      "action": "require",
      "conditions": [
        "catalog.schemaVersion equals number 1",
        "catalog.games is a list"
      ],
      "error": "games.json uses an unsupported format. Update Game Reminders on Windows."
    },
    {
      "action": "repeatEach",
      "input": "catalog.games",
      "item": "game",
      "steps": [
        {
          "action": "getDictionaryValue",
          "input": "game",
          "key": "name",
          "output": "gameName"
        }
      ],
      "output": "gameNames"
    },
    {
      "action": "chooseFromList",
      "input": "gameNames",
      "prompt": "Choose a game",
      "selectMultiple": false,
      "output": "selectedGameName"
    },
    {
      "action": "repeatEach",
      "input": "catalog.games",
      "item": "game",
      "steps": [
        {
          "action": "if",
          "condition": "game.name equals selectedGameName",
          "then": [
            {
              "action": "setVariable",
              "variable": "matchedGameId",
              "value": "game.id"
            },
            {
              "action": "setVariable",
              "variable": "matchedGameName",
              "value": "game.name"
            }
          ]
        }
      ]
    },
    {
      "action": "askForText",
      "prompt": "What should I remind you?",
      "output": "message"
    },
    {
      "action": "requireNonWhitespace",
      "input": "message",
      "error": "Enter a reminder."
    },
    {
      "action": "generateUuid",
      "output": "reminderId"
    },
    {
      "action": "currentDate",
      "format": "ISO 8601",
      "output": "createdAt"
    },
    {
      "action": "dictionary",
      "output": "reminder",
      "entries": {
        "schemaVersion": 1,
        "id": "reminderId",
        "gameId": "matchedGameId",
        "gameNameAtCreation": "matchedGameName",
        "message": "message",
        "createdAt": "createdAt"
      }
    },
    {
      "action": "serializeJson",
      "input": "reminder",
      "output": "reminderJson"
    },
    {
      "action": "createFolder",
      "folder": "Shortcuts",
      "output": "inboxFolder",
      "path": "Game Reminders/inbox",
      "existingBehavior": "reuse"
    },
    {
      "action": "saveFile",
      "input": "reminderJson",
      "folder": "Shortcuts",
      "name": "<reminderId>.tmp",
      "overwrite": false,
      "output": "stagedFile"
    },
    {
      "action": "moveFile",
      "input": "stagedFile",
      "folder": "inboxFolder",
      "overwrite": false,
      "output": "inboxStagedFile"
    },
    {
      "action": "renameFile",
      "input": "inboxStagedFile",
      "name": "<reminderId>.json",
      "overwrite": false,
      "output": "savedReminder"
    },
    {
      "action": "showResult",
      "message": "Reminder saved for <matchedGameName>.",
      "onlyAfter": "savedReminder"
    }
  ]
}
